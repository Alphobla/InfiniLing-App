  "audio": {
    "voice": "onyx",
    "model": "gpt-4o-mini-tts",
    "pause_duration": 0.5
  },
  "text_generation": {
    "model": "gpt-4o-mini",
    "temperature": 0.7,
    "max_tokens_per_word": 1.5
  },
  "word_enhancement": {
    "model": "gpt-4.1-nano-2025-04-14",
    "temperature": 0.1,
    "max_tokens": 200
  },
  "paths": {
    "data_dir": "./data",
    "transcriptions_dir": "./data/transcriptions_and_audio",
    "temp_audio_file": "infiniling_audio.mp3",
    "temp_text_file": "infiniling_text.txt",
    "temp_words_file": "infiniling_words.json"
  },
  "ui": {
