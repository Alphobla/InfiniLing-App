{
  "app": {
    "name": "InfiniLing",
    "version": "1.0.0",
    "debug": false
  },
  "vocabulary": {
    "default_total_words": 20,
    "default_new_word_ratio": 0.25,
    "default_text_length": 300,
    "languages": {
