      "gentexter": {
        "width": 500,
        "height": 700
      },
      "reader": {
        "width": 850,
        "height": 720
      }
    },
    "colors": {
      "background": "#f8f9fa",
      "surface": "#ffffff",
      "primary": "#0078d4",
      "secondary": "#27ae60"
    },
    "fonts": {
      "family": "Segoe UI",
      "sizes": {
        "title": 20,
        "heading": 18,
        "body": 11,
        "small": 10
      }
    }
  },
  "transcriber": {
